[sub_resource type="GDScript" id="GDScript_nt7q6"]
resource_name = "UI"
script/source = "extends CanvasLayer

var game_over_screen = preload(\"res://scenes/screens/game_over.tscn\")
var day_completed_screen = preload(\"res://scenes/screens/day_completed/day_completed.tscn\")
var upgrade_selection_screen = preload(\"res://scenes/screens/day_completed/upgrade_selection.tscn\")

# Keep track of active overlay instances so we can delete them on reset
var active_screen_overlay: Node = null


func _ready():
	# Prepare UI when added to scene
	init_ui()
	
	# Listen for updates from GameState
	GameState.day_completed.connect(_on_day_completed)
	GameState.day_failed.connect(_on_day_failed)
	GameState.day_started.connect(init_ui)
	
## Setup the UI for the current day
func init_ui():
	# Absolute guard: if child nodes aren't ready yet, wait until they are!
	if not is_inside_tree():
		await ready
		
	# Clean up any lingering victory/defeat popup overlay windows
	if is_instance_valid(active_screen_overlay):
		active_screen_overlay.queue_free()
		active_screen_overlay = null
	
	for child in %WordDisplay.get_children():
		child.queue_free()
	
	%Score.text = \"Score: \" + str(GameState.score)
	%Score.modulate = Color.WHITE
	%RequiredScore.text = \"Need: \" + str(GameState.required_score)
	%WordsRemainingLabel.text = \"Words Remaining: \" + str(GameState.words_remaining)
	
	%DayCounterLabel.text = \"WEEK \" + str(GameState.current_week)
	%DayCounterLabel.text += \"\\n\" + GameState.day_to_string(GameState.current_day)
	%DayCounterLabel.modulate = Color.WHITE
	
	%Bar.max_value = GameState.required_score
	%Bar.value = GameState.score
	
	for child in %SubmittedWords.get_children():
		child.queue_free()

	
## Pause scene and show day completed screen.
func _on_day_completed():
	get_tree().paused = true
	%DayCounterLabel.text = \"PASSED!\"
	%DayCounterLabel.modulate = Color.CHARTREUSE
	
	var upgrade_menu = upgrade_selection_screen.instantiate()
	add_child(upgrade_menu)
	
	upgrade_menu.upgrade_selected.connect(_show_day_completed_screen)
	
func _show_day_completed_screen() -> void:
	active_screen_overlay = day_completed_screen.instantiate()
	add_child(active_screen_overlay)
	await get_tree().create_timer(0.25).timeout
	if active_screen_overlay.has_method(\"display_completed_day\"):
		active_screen_overlay.display_completed_day()
	
	
# Pause scene and show day failed screen.
func _on_day_failed():
	get_tree().paused = true
	%DayCounterLabel.text = \"FAILED\"
	%DayCounterLabel.modulate = Color.RED
	active_screen_overlay = game_over_screen.instantiate()
	add_child(active_screen_overlay)
		
func _on_complete_day_pressed() -> void:
	GameState.day_completed.emit()

func _on_next_day_pressed() -> void:
	GameState.load_next_day()

func _on_lose_day_pressed() -> void:
	GameState.day_failed.emit()
"

